# Environment variables for Agent-Termo
# Copy this to .env and fill in the values

# Nvidia NIM API configuration
# Get your free API key from https://build.nvidia.com/
NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model configuration
# IMPORTANT: Use DOT notation in model names, NOT underscores.
# Wrong:  meta/llama-3_1-8b-instruct   (returns HTTP 404)
# Correct: meta/llama-3.1-8b-instruct  (works)
#
# Known working free-tier models:
#   meta/llama-3.1-8b-instruct   — Fast, low-cost (recommended default)
#   meta/llama-3.1-70b-instruct  — Higher quality, slower
#
# You can also switch models inside Agent-Termo with /model. That choice is saved
# to ~/.agent-termo/config.json and takes precedence over NIM_MODEL below
# (the --model CLI flag still overrides both).
NIM_MODEL=meta/llama-3.1-8b-instruct

# Context and output budgeting
# Agent-Termo loads documented context limits for known NVIDIA NIM model IDs.
# This example uses Llama 3.1 8B (128K context; provider max output 4,096).
# The 8,192-token reserve is retained for budgeting; the actual max_tokens
# request is capped to the selected provider model's documented output maximum.
AGENT_TERMO_OUTPUT_RESERVE_TOKENS=8192
AGENT_TERMO_CONTEXT_SAFETY_MARGIN=2048
# Optional override for custom/unlisted deployments; leave unset for model lookup.
# AGENT_TERMO_CONTEXT_WINDOW=131072

# Agent behavior
AGENT_TERMO_DIR=.claude
AGENT_TERMO_DOCS=docs
AGENT_TERMO_MEMORY=docs/MEMORY.md
AGENT_TERMO_TIMELINE=docs/TIMELINE.md

# Logging
LOG_LEVEL=info
DEBUG=false

# Safety
CONFIRM_DESTRUCTIVE=true
ALLOWED_COMMANDS=git,npm,node,pnpm,yarn,tsx,tsc

# Timeout settings (milliseconds)
LLM_TIMEOUT=120000
BASH_TIMEOUT=300000