# Environment variables for Agent-Termo
# Copy this to .env and fill in the values

# Nvidia NIM API configuration
# Get your free API key from https://build.nvidia.com/
NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model configuration
# IMPORTANT: Use DOT notation in model names, NOT underscores.
# Wrong:  meta/llama-3_1-8b-instruct   (returns HTTP 404)
# Correct: meta/llama-3.1-8b-instruct  (works)
#
# Known working free-tier models:
#   meta/llama-3.1-8b-instruct   — Fast, low-cost (recommended default)
#   meta/llama-3.1-70b-instruct  — Higher quality, slower
NIM_MODEL=meta/llama-3.1-8b-instruct

# Agent behavior
AGENT_TERMO_DIR=.claude
AGENT_TERMO_DOCS=docs
AGENT_TERMO_MEMORY=docs/MEMORY.md
AGENT_TERMO_TIMELINE=docs/TIMELINE.md

# Logging
LOG_LEVEL=info
DEBUG=false

# Safety
CONFIRM_DESTRUCTIVE=true
ALLOWED_COMMANDS=git,npm,node,pnpm,yarn,tsx,tsc

# Timeout settings (milliseconds)
LLM_TIMEOUT=120000
BASH_TIMEOUT=300000