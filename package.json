{
  "name": "agent-termo",
  "version": "1.0.19",
  "description": "Terminal-based AI coding agent that replicates Claude Code experience",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "agent-termo": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsx scripts/build.mjs",
    "build:tsc": "tsc",
    "build:esbuild": "node scripts/build.mjs",
    "build:pkg": "pkg --targets node20-win-x64,node20-macos-x64,node20-linux-x64 --output dist/",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "cli": "tsx src/cli.ts"
  },
  "keywords": [
    "cli",
    "terminal",
    "ai",
    "agent",
    "coding",
    "llm",
    "nvidia",
    "nim"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krish2312005/agent-termo.git"
  },
  "homepage": "https://github.com/krish2312005/agent-termo#readme",
  "bugs": {
    "url": "https://github.com/krish2312005/agent-termo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "blessed": "^0.1.10",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "glob": "^14.0.6",
    "marked": "^12.0.0",
    "openai": "^7.57.0",
    "simple-git": "^4.0.2",
    "zod": "^4.6.7",
    "@modelcontextprotocol/client": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.4.0",
    "pkg": "^5.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "pkg": {
    "targets": [
      "node20-win-x64",
      "node20-macos-x64",
      "node20-linux-x64"
    ],
    "outputPath": "dist"
  }
}
