{
  "name": "agent-termo",
  "version": "1.0.20",
  "description": "Terminal-based AI coding agent that replicates Claude Code experience",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "agent-termo": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts",
    "build": "bun scripts/build.mjs",
    "prepublishOnly": "bun run build",
    "typecheck": "bunx tsc --noEmit",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage",
    "lint": "bunx eslint src --ext .ts,.tsx",
    "lint:fix": "bunx eslint src --ext .ts,.tsx --fix",
    "cli": "bun src/cli.ts"
  },
  "keywords": [
    "cli",
    "terminal",
    "ai",
    "agent",
    "coding",
    "llm",
    "nvidia",
    "nim"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krish2312005/agent-termo.git"
  },
  "homepage": "https://github.com/krish2312005/agent-termo#readme",
  "bugs": {
    "url": "https://github.com/krish2312005/agent-termo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "blessed": "^0.1.10",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "glob": "^14.0.6",
    "marked": "^12.0.0",
    "openai": "^7.57.0",
    "simple-git": "^4.0.2",
    "zod": "^4.6.7",
    "@modelcontextprotocol/client": "^2.4.0",
    "@opentui/core": "0.9.7",
    "@opentui/solid": "0.9.7",
    "solid-js": "^1.9.16"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.4.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "dist",
    "src"
  ],
  "packageManager": "bun@1.3.14"
}
